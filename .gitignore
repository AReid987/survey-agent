# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.pylint.d/

# ── Virtual environment ──────────────────────────────────────────
.venv/

# ── Node ──────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── IDE ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ── Per-machine Claude Code commands (SEED, etc.) ─────────────────
# `.claude/skills/` is project-tracked (shared skills); `.claude/commands/`
# are installable per machine.
.claude/commands/

# ── Brain foundation (profile-derived data, LLM-generated proposals) ──
# Spec: docs/superpowers/specs/2026-07-16-brain-foundation-design.md
# data/brain/ contains events.jsonl, brain.db (SQLite WAL),
# rules.yaml (LLM-generated), persona_hints.json (LLM-generated),
# diffs/*.json (before/after snapshots of profile.json — sensitive),
# last_digest.txt, paused.
data/brain/
!data/brain/.gitkeep

# ── GitNexus ─────────────────────────────────────────────────────
.gitnexus/*.db
.gitnexus/*.sqlite

# ── MegaLinter ───────────────────────────────────────────────────
megalinter-reports/

# ── RepoAtlas ───────────────────────────────────────────────────
.repoatlas.json

# ── Playwright / Browser session data ────────────────────────────
data/browser_session/
data/camoufox_session/

# Chrome runtime symlinks in agent profile dirs (regenerated on launch)
data/chrome_agent_*/Singleton*
data/chrome_agent_*/RunningChromeVersion

# ── Environment ──────────────────────────────────────────────────
.env
.env.local
.env.production
.vercel
.agenttrail/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
